{%- liquid
  assign heading = section.settings.heading
  assign subtitle = section.settings.subtitle
  assign subtitle_link_text = section.settings.subtitle_link_text
  assign subtitle_link_url = section.settings.subtitle_link_url
  assign mobile_label = section.settings.mobile_label
  assign mobile_subtitle = section.settings.mobile_subtitle
  assign button_text = section.settings.button_text
  assign button_url = section.settings.button_url
-%}

<div
  id="Ingredients-{{ section.id }}"
  class="ingredients spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div class="ingredients__content">
    <div class="ingredients__text-col">
      {% if heading != blank %}
        <div class="ingredients__heading">{{ heading }}</div>
      {% endif %}

      <hr class="ingredients__divider">

      {% if subtitle != blank or subtitle_link_text != blank %}
        <p class="ingredients__subtitle">
          {{ subtitle }}
          {% if subtitle_link_text != blank %}
            <a
              {% if subtitle_link_url != blank %}href="{{ subtitle_link_url }}"{% endif %}
              class="ingredients__subtitle-link"
            >{{ subtitle_link_text }}</a>
          {% endif %}
        </p>
      {% endif %}

      <hr class="ingredients__divider">

      <div class="ingredients__usa-bar">
        <div class="ingredients__usa-left">
          <img
            src="{{ 'flag.svg' | asset_url }}"
            alt="USA flag"
            width="27"
            height="17"
            loading="lazy"
          >
          {% if mobile_label != blank %}
            <span class="ingredients__usa-label">{{ mobile_label }}</span>
          {% endif %}
        </div>
        {% if mobile_subtitle != blank %}
          <span class="ingredients__usa-subtitle">{{ mobile_subtitle }}</span>
        {% endif %}
      </div>

      {% if button_text != blank %}
        <div class="ingredients__cta ingredients__cta--desktop">
          <a
            {% if button_url != blank %}href="{{ button_url }}"{% endif %}
            class="ingredients__button"
          >{{ button_text }}</a>
        </div>
      {% endif %}
    </div>

    <div class="ingredients__grid-col">
      <div class="ingredients__grid">
        {% for block in section.blocks %}
          <div class="ingredients__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {%- liquid
                assign img = block.settings.image
                assign sizes_val = '(min-width: 750px) 185px, calc(50vw - 24px)'
              -%}
              {{
                img
                | image_url: width: img.width
                | image_tag:
                  sizes: sizes_val,
                  widths: '177,185,354,370,550',
                  loading: 'lazy',
                  class: 'ingredients__card-img',
                  alt: img.alt
              }}
            {% endif %}
            {% if block.settings.title != blank %}
              <span class="ingredients__card-label">{{ block.settings.title }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    {% if button_text != blank %}
      <div class="ingredients__cta ingredients__cta--mobile">
        <a
          {% if button_url != blank %}href="{{ button_url }}"{% endif %}
          class="ingredients__button"
        >{{ button_text }}</a>
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .ingredients__content {
    max-width: 1200px;
    margin-inline: auto;
    width: 100%;
    padding-inline: 12px;
    display: flex;
    flex-direction: row;
    gap: 60px;
    align-items: center;
  }

  .ingredients__text-col {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ingredients__grid-col {
    flex: 1;
  }

  .ingredients__heading {
    font-family: var(--font-heading--family);
    font-weight: 400;
    font-size: 48px;
    line-height: 52px;
    letter-spacing: -1px;
    color: var(--color-foreground);
    margin: 0;

    & p {
      margin: 0;
    }

    & strong {
      font-weight: 700;
    }
  }

  .ingredients__divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
    width: 100%;
  }

  .ingredients__subtitle {
    font-family: var(--font-subheading--family);
    font-weight: 500;
    font-size: 20px;
    line-height: 24px;
    color: var(--color-foreground);
    margin: 0;
  }

  .ingredients__subtitle-link {
    text-decoration: underline;
    color: inherit;
  }

  .ingredients__usa-bar {
    display: none;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    border: 1px solid var(--color-border);
    padding: 12px 0;
  }

  .ingredients__usa-left {
    display: flex;
    flex-direction: row;
    gap: 13px;
    align-items: center;
    padding-inline: 8px;
  }

  .ingredients__usa-left img {
    display: block;
    width: 27px;
    height: 17px;
  }

  .ingredients__usa-label {
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 12px;
    line-height: 14px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: var(--color-foreground);
  }

  .ingredients__usa-subtitle {
    font-family: var(--font-subheading--family);
    font-weight: 500;
    font-size: 14px;
    line-height: 18px;
    text-align: center;
    color: var(--color-foreground);
  }

  .ingredients__cta--desktop {
    padding: 16px 0;
  }

  .ingredients__cta--mobile {
    display: none;
  }

  .ingredients__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 28px;
    border: 2px solid #000000;
    background: transparent;
    padding: 12px 20px;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    color: #000000;
    text-decoration: none;
    box-sizing: border-box;
    cursor: pointer;
  }

  .ingredients__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    overflow: hidden;
  }

  .ingredients__card {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    aspect-ratio: 185 / 200;
  }

  .ingredients__card-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: absolute;
    inset: 0;
  }

  .ingredients__card-label {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 12px 16px;
    font-family: var(--font-accent--family);
    font-weight: 400;
    font-size: 16px;
    line-height: 16px;
    letter-spacing: 0.75px;
    text-transform: uppercase;
    text-align: center;
    color: #FFFFFF;
  }

  @media screen and (max-width: 749px) {
    .ingredients__content {
      flex-direction: column;
      gap: 20px;
      align-items: stretch;
    }

    .ingredients__text-col {
      flex: none;
    }

    .ingredients__grid-col {
      flex: none;
    }

    .ingredients__heading {
      font-size: 32px;
      line-height: 36px;
    }

    .ingredients__divider {
      display: none;
    }

    .ingredients__subtitle {
      display: none;
    }

    .ingredients__cta--desktop {
      display: none;
    }

    .ingredients__usa-bar {
      display: flex;
    }

    .ingredients__cta--mobile {
      display: block;
      width: 100%;
    }

    .ingredients__button {
      font-size: 14px;
      line-height: 14px;
      width: 100%;
    }

    .ingredients__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    .ingredients__card:nth-child(n+7) {
      display: none;
    }

    .ingredients__card-label {
      font-size: 14px;
      line-height: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredients",
  "tag": "section",
  "class": "ingredients-wrapper section-wrapper",
  "settings": [
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Made from clinically researched and <strong>sustainably sourced ingredients.</strong></p>"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Made in the USA with carefully sourced ingredients from around the world. From source to formula, each ingredient is chosen with purpose."
    },
    {
      "type": "text",
      "id": "subtitle_link_text",
      "label": "Subtitle link text",
      "default": "About ingredients."
    },
    {
      "type": "url",
      "id": "subtitle_link_url",
      "label": "Subtitle link URL"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "text",
      "id": "mobile_label",
      "label": "Mobile label",
      "default": "Made in USA"
    },
    {
      "type": "text",
      "id": "mobile_subtitle",
      "label": "Mobile subtitle",
      "default": "with globally sourced ingredients"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Show All Ingredients"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "Top padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "Bottom padding",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 80,
      "unit": "px"
    }
  ],
  "blocks": [
