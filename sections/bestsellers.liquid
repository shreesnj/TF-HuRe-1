          ]
        },
        {
          "type": "header",
          "content": "Content"
        },
        {
          "type": "text",
          "id": "product_title",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        },
