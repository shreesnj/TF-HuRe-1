{% liquid
  assign block_settings = block.settings
  assign image = block_settings.image
  assign heading = block_settings.heading
  assign link_text = block_settings.link_text
  assign link_url = block_settings.link_url
%}

<a
  class="footer-promo-card"
  {% if link_url != blank %}href="{{ link_url }}"{% endif %}
  {{ block.shopify_attributes }}
>
  {% if image != blank %}
    <div class="footer-promo-card__image-wrapper">
      {{
        image
        | image_url: width: image.width
        | image_tag:
          sizes: '340px',
          widths: '340,480,680',
          loading: 'lazy',
          class: 'footer-promo-card__image',
          alt: image.alt
      }}
    </div>
  {% endif %}
  <div class="footer-promo-card__overlay"></div>
  <div class="footer-promo-card__content">
    {% if heading != blank %}
      <span class="footer-promo-card__heading">{{ heading | escape }}</span>
    {% endif %}
    {% if link_text != blank %}
      <span class="footer-promo-card__link-text">{{ link_text | escape }}</span>
    {% endif %}
  </div>
</a>

{% stylesheet %}
  .footer-promo-card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    max-width: 340px;
    min-height: 220px;
    border-radius: 8px;
    overflow: hidden;
    background-color: #E6F0F8;
    text-decoration: none;
    color: #FFFFFF;
  }

  .footer-promo-card__image-wrapper {
    position: absolute;
    inset: 0;
  }

  .footer-promo-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
  }

  .footer-promo-card__overlay {
    position: absolute;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.2);
    pointer-events: none;
  }

  .footer-promo-card__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 20px;
    text-align: center;
  }

  .footer-promo-card__heading {
    font-family: var(--font-heading--family);
    font-size: 20px;
    line-height: 26px;
    letter-spacing: -0.2px;
    font-weight: 400;
    color: #FFFFFF;
  }

  .footer-promo-card__link-text {
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 23px;
    text-decoration: underline;
    color: #FFFFFF;
  }

  @media screen and (max-width: 749px) {
    .footer-promo-card {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Promo card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find Your Filter"
    },
    {
      "type": "text",
      "id": "link_text",
      "label": "Link text",
      "default": "Lab Test Results"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Promo card",
      "category": "t:categories.footer"
    }
  ]
}
{% endschema %}
